{
  "name": "Standing Order Scheduler \u2014 Digital Banking Backend (v1.2)",
  "nodes": [
    {
      "id": "13015612-84fd-4e97-bc42-2698aa371968",
      "name": "Cron Trigger (daily)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "notes": "Runs each morning after end-of-day processing."
    },
    {
      "id": "8f805067-54c8-44f5-b27b-df9e0614ec79",
      "name": "Adjust for Business Day (Code)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        250,
        0
      ],
      "parameters": {
        "jsCode": "// Shifts today's target execution date to the prior business day\n// if today falls on a weekend or bank holiday (n8n Spec Sec. 7).\nconst today = new Date();\nconst adjusted = shiftToPriorBusinessDay(today); // holiday calendar lookup\nreturn [{ json: { run_date: adjusted } }];"
      },
      "notes": "Weekend/holiday adjustment happens once, up front, before any orders are fetched."
    },
    {
      "id": "7b94b278-1459-4d3c-ac26-b6bfc06caf6e",
      "name": "Fetch Due Orders (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        500,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, account_id, amount, recipient_account_token, version, retry_count FROM standing_orders WHERE next_run_date = '{{$json[\"run_date\"]}}' AND status = 'ACTIVE';"
      },
      "notes": "Reads the current `version` column per row for optimistic locking later in this flow."
    },
    {
      "id": "4c15f69c-e0be-4fae-ba85-a13e22fc33f1",
      "name": "Balance Check (Python service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        750,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/accounts/balance-check",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "amount",
              "value": "={{$json[\"amount\"]}}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Verifies sufficient funds before any execution attempt."
    },
    {
      "id": "a1ea65a4-a034-4220-bde3-17c2fc414f52",
      "name": "Sufficient Funds?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"sufficient\"]}}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "3a3531b9-b279-4130-b7a4-e2d5fab2e7a0",
      "name": "Log Retry Attempt (Postgres update)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1250,
        250
      ],
      "parameters": {
        "operation": "update",
        "table": "standing_orders",
        "updateKey": "id",
        "columns": "retry_count,last_attempt_at"
      },
      "notes": "Unsupervised: insufficient-funds retry attempts, up to the 3-attempt limit, may execute without human sign-off."
    },
    {
      "id": "0312bfe4-2c3b-47d8-b5d0-90d60d449459",
      "name": "Retry Count >= 3?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1500,
        250
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"retry_count\"]}}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 3
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "4d61d415-e751-4204-9cc1-2db9105adb03",
      "name": "Permanent Failure Notice (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        1750,
        350
      ],
      "parameters": {
        "operation": "send",
        "message": "Your standing order could not be executed after 3 attempts within 48 hours due to insufficient funds. It has been paused \u2014 please fund your account and contact support to resume it."
      },
      "notes": "Sent only after the 3rd failed attempt (n8n Spec Sec. 7)."
    },
    {
      "id": "c48ac1ce-78f7-4fcb-bedd-65602769b3da",
      "name": "Fraud Score (Python: /fraud/score) [NEW v1.2]",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1250,
        -150
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/fraud/score",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "transaction_id",
              "value": "={{$json[\"id\"]}}"
            },
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "amount",
              "value": "={{$json[\"amount\"]}}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Same endpoint used by Transaction Execution \u2014 closes the gap where a hijacked standing order previously ran unscored because no customer email triggered it."
    },
    {
      "id": "7c06a41d-d8ae-4ba1-8a28-74563cedb1b4",
      "name": "Fraud Breach?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1500,
        -150
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"flag\"]}}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "090fc096-1a6e-4d76-9de1-090a4308e79e",
      "name": "Execute Workflow: Fraud Monitoring",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        1750,
        -300
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "value": "FRAUD_MONITORING_WORKFLOW_ID",
          "mode": "id"
        }
      },
      "notes": "A flagged due-execution is held via the shared Fraud Monitoring workflow rather than executed and scored afterward."
    },
    {
      "id": "d8fca3d8-6287-4f6b-b962-e9ba6477dc09",
      "name": "Execute Standing Order Transfer (Python: /transactions/execute)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1750,
        -50
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/transactions/execute",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "amount",
              "value": "={{$json[\"amount\"]}}"
            },
            {
              "name": "recipient_account_token",
              "value": "={{$json[\"recipient_account_token\"]}}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Atomic debit+credit inside a single Postgres transaction with row-level locking, same service used by manual transfers."
    },
    {
      "id": "0398ab65-a56c-4bfd-bd39-4dcc19cba2de",
      "name": "Version Guard (Postgres conditional update)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2000,
        -50
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE standing_orders SET version = version + 1, last_executed_at = now() WHERE id = '{{$json[\"id\"]}}' AND version = {{$json[\"version\"]}};"
      },
      "notes": "Zero rows affected means a concurrent edit occurred on this order \u2014 triggers a re-fetch rather than a silent double-execution."
    },
    {
      "id": "ca996924-4e84-4ea1-b7db-6920a4655f9b",
      "name": "Version Guard Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2250,
        -50
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"rows_affected\"]}}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "3c6c974a-46d5-4991-a718-c72522886bf3",
      "name": "Send Execution Confirmation (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        2500,
        -150
      ],
      "parameters": {
        "operation": "send",
        "message": "Your standing order has been executed successfully."
      }
    },
    {
      "id": "fac280cb-4fbc-4f6f-a176-1fb92c32abfc",
      "name": "Requeue for Re-fetch (NoOp)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2500,
        50
      ],
      "parameters": {},
      "notes": "Concurrent edit detected \u2014 this order is left for the next Fetch Due Orders pass rather than force-applied over a stale version."
    },
    {
      "id": "2102691b-0351-403c-8744-343a189dd126",
      "name": "Log Email Event (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2750,
        -150
      ],
      "parameters": {
        "operation": "insert",
        "table": "email_audit_log",
        "columns": "sender,intent,action_taken,redaction_flag,timestamp"
      }
    }
  ],
