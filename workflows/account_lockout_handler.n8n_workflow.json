{
  "name": "Account Lockout Handler — Digital Banking Backend (v1.2)",
  "nodes": [
    {
      "id": "e1c38f23-ae76-4359-9ab6-cff895f36f40",
      "name": "When Called (Sub-workflow Trigger)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "account_id"
            },
            {
              "name": "account_holder_id"
            },
            {
              "name": "action_type"
            },
            {
              "name": "password"
            },
            {
              "name": "challenge_code"
            },
            {
              "name": "thread_id"
            }
          ]
        }
      },
      "notes": "Shared sub-workflow — called by Transaction Execution, Statement Request, and Account Closure (n8n Spec Sec. 3). action_type = TRANSACTION or STATEMENT."
    },
    {
      "id": "7e5b7acb-0223-4582-913b-4f64aa69be7a",
      "name": "Check Account Status (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        250,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT status FROM accounts WHERE id = '{{$json[\"account_id\"]}}';"
      },
      "notes": "FR-6.5: if status = SUSPENDED, fixed rejection regardless of password correctness — password is not even checked."
    },
    {
      "id": "4d26d62f-0b09-4731-b4b2-0ff3d21fd5b9",
      "name": "Is SUSPENDED?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"status\"]}}",
              "rightValue": "SUSPENDED",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "626c6c5d-0e23-4d22-ab32-12a4f1d6a22b",
      "name": "Send Fixed Rejection + Reactivation Steps",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "reply",
        "message": "Your account is suspended. To reactivate, reply to this email confirming your full name, date of birth, and last transaction amount. You will then receive a phone OTP, followed by staff review."
      },
      "notes": "Points the customer to the Account Reactivation flow (FR-6.6/FR-6.11). Router's Account Status Branch should normally intercept SUSPENDED senders earlier, but this is the fail-safe here too."
    },
    {
      "id": "adbcc167-62ed-4971-9f7b-2f9ea44a9826",
      "name": "Verify Password (Python: /auth/verify-password)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/auth/verify-password",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_holder_id",
              "value": "={{$json[\"account_holder_id\"]}}"
            },
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "action_type",
              "value": "={{$json[\"action_type\"]}}"
            },
            {
              "name": "password",
              "value": "={{$json[\"password\"]}}"
            },
            {
              "name": "challenge_code",
              "value": "={{$json[\"challenge_code\"]}}"
            }
          ]
        }
      },
      "notes": "FR-6.9: compares against the SENDING HOLDER's account_holders.transaction_password_hash (not account-level). STATEMENT checks statement_pdf_password_hash instead. Comparison happens ONLY in the Python service — n8n never compares hashes itself."
    },
    {
      "id": "995f123c-6778-4900-9fdf-1bc817845c08",
      "name": "Correct?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1250,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"match\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "467806cd-5859-45ab-8c3c-421b0743f9ce",
      "name": "Reset Counter (Postgres update)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1500,
        -150
      ],
      "parameters": {
        "operation": "update",
        "table": "accounts",
        "updateKey": "id",
        "columns": "failed_password_attempts"
      },
      "notes": "failed_password_attempts = 0. Allows the calling workflow (Transaction/Statement/Closure) to proceed — this node's success output IS the 'pass' signal."
    },
    {
      "id": "3c5f269a-51b9-4f93-84b0-285aa16ff121",
      "name": "Increment Counter (Postgres update)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1500,
        150
      ],
      "parameters": {
        "operation": "update",
        "table": "accounts",
        "updateKey": "id",
        "columns": "failed_password_attempts,last_failed_attempt_at"
      },
      "notes": "failed_password_attempts += 1; last_failed_attempt_at = now(). NOTE: this counter increments ONLY on a genuine password mismatch — a challenge-code-only failure (410 from the verify call) must NOT reach this node (FR-6.10)."
    },
    {
      "id": "56045ee0-3af8-4c68-85be-3e90f42e9f16",
      "name": "Threshold Check (>=3?)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1750,
        150
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"failed_attempts\"]}}",
              "rightValue": 3,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "1a90561c-f0dc-4856-ae54-d3eb45ba33b3",
      "name": "Suspend Account (Postgres update + Gmail)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2000,
        250
      ],
      "parameters": {
        "operation": "update",
        "table": "accounts",
        "updateKey": "id",
        "columns": "status"
      },
      "notes": "status = SUSPENDED after the 3rd consecutive failure (FR-6.5). Immediately followed by the suspension-notice email node below."
    },
    {
      "id": "ddadc053-540a-42f6-9e8b-bde3a468564a",
      "name": "Send Suspension Notice (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        2250,
        250
      ],
      "parameters": {
        "operation": "reply",
        "message": "Your account has been suspended after 3 failed password attempts. To reactivate: reply confirming your full name, date of birth, and last transaction amount; you'll then receive a phone OTP, followed by staff review."
      },
      "notes": "FR-6.8: immediate notification explaining the exact Account Reactivation steps — unsupervised action."
    },
    {
      "id": "f2956731-a87a-425b-be4b-647b506a1531",
      "name": "Send Attempts-Remaining Warning (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        2000,
        50
      ],
      "parameters": {
        "operation": "reply",
        "message": "Incorrect password. {{3 - $json[\"failed_attempts\"]}} attempt(s) remaining before your account is suspended."
      },
      "notes": "Failure counter is below 3 — warn, don't suspend yet."
    },
    {
      "id": "8efcfb9b-2d36-4bac-9cd0-01e9a7f6d892",
      "name": "Respond to Caller: PASS",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1750,
        -150
      ],
      "parameters": {},
      "notes": "Output returned to whichever workflow called this sub-workflow (Transaction Execution / Statement Request / Account Closure) — signals it is safe to continue."
    },
    {
      "id": "3817e46c-19c4-4118-b21c-4354fceeddf9",
      "name": "Respond to Caller: FAIL / STOP",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2500,
        150
      ],
      "parameters": {},
      "notes": "Output tells the calling workflow to stop — do not proceed to the sensitive action."
    }
  ],
  "connections": {
