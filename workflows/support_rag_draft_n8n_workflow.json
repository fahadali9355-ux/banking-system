{
  "name": "Support / RAG Draft \u2014 Digital Banking Backend (v1.2)",
  "nodes": [
    {
      "id": "02af860a-b063-417a-9d8a-b1ddda63c45e",
      "name": "When Called by Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "account_holder_id"
            },
            {
              "name": "account_id"
            },
            {
              "name": "thread_id"
            },
            {
              "name": "redacted_query"
            },
            {
              "name": "case_category"
            }
          ]
        }
      },
      "notes": "Receives the already-PII-redacted customer message and its classified case_category from the Main Email Router."
    },
    {
      "id": "14986af5-e739-4e49-a7ce-1ab03d2b08cd",
      "name": "Pinecone Retrieval (LangChain)",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1,
      "position": [
        250,
        0
      ],
      "parameters": {
        "mode": "retrieve",
        "topK": 5,
        "options": {
          "metadataFilter": "={{ {\"case_category\": $json[\"case_category\"], \"policy_version\": \"current\"} }}"
        }
      },
      "notes": "Top-k semantic search over the support-policy namespace. Similarity >= 0.75 AND a matching metadata filter (case_category, policy_version) are both required."
    },
    {
      "id": "16b6ebe1-d718-4ecc-a9d1-9df1c76d32fb",
      "name": "No-Match Fallback",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"top_similarity\"]}}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 0.75
            }
          ],
          "combinator": "and"
        }
      },
      "notes": "Below threshold or no metadata match routes straight to human escalation, skipping drafting entirely."
    },
    {
      "id": "bcf66112-c534-465a-8ffe-1382742ac127",
      "name": "Escalate: No Confident Match (Postgres + Gmail internal)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        750,
        200
      ],
      "parameters": {
        "operation": "send",
        "message": "No sufficiently similar/verified policy match was found for this support request. Routing directly to a human agent \u2014 no draft was generated."
      },
      "notes": "draft_responses.status = escalated_no_match, written before this send (Postgres insert not shown separately for brevity \u2014 same pattern as Queue for Approval)."
    },
    {
      "id": "c7560be9-40f2-4d8b-998f-06ef62077d03",
      "name": "Draft Response (Groq, redacted input)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "position": [
        750,
        -150
      ],
      "parameters": {
        "text": "={{$json[\"redacted_query\"]}}",
        "promptType": "define",
        "text2": "Draft a customer support reply grounded strictly in the retrieved context below. Do not state anything the retrieved passages do not support. Input is already PII-redacted."
      },
      "notes": "NFR: every drafted reply must be traceable to retrieved source material \u2014 no free-standing claims."
    },
    {
      "id": "37067324-f377-44c0-8fed-6ff17bc7525b",
      "name": "Verify Draft (LangChain, second pass)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "position": [
        1000,
        -150
      ],
      "parameters": {
        "text": "={{$json[\"draft_text\"]}}",
        "promptType": "define",
        "text2": "Compare this draft against the retrieved source passages. List any claim in the draft that is NOT directly supported by the sources."
      },
      "notes": "A dedicated second pass whose only job is to catch hallucinated claims before a human ever sees the draft."
    },
    {
      "id": "5b484842-19ef-4932-b010-9eafd7dfa9ff",
      "name": "Unsupported Claims Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1250,
        -150
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"unsupported_claims\"].length}}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "f532cb74-a7fc-4225-9ff4-a08d2cbff75e",
      "name": "Flag for Manual Rewrite (Postgres + Gmail internal)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        1500,
        50
      ],
      "parameters": {
        "operation": "send",
        "message": "The drafted reply below contains claims not supported by retrieved policy documents and cannot go through auto-approval flow. Please rewrite manually."
      },
      "notes": "draft_responses.status = flagged_hallucination \u2014 distinct from a normal pending_approval draft so reviewers know why it needs a rewrite, not just a rubber stamp."
    },
    {
      "id": "998794d0-615a-4357-bfa4-4c771e260390",
      "name": "Generate Explanation (LangChain)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "position": [
        1500,
        -300
      ],
      "parameters": {
        "text": "={{$json[\"draft_text\"]}}",
        "promptType": "define",
        "text2": "Write a short, plain-language rationale for this draft reply: which retrieved passages it relies on and why they apply here."
      },
      "notes": "Shown to the reviewer alongside the draft so approval is an informed decision, not a blind click."
    },
    {
      "id": "417e5cbc-3751-4372-b880-ceeb8a29c446",
      "name": "Queue for Approval (Postgres insert)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1750,
        -300
      ],
      "parameters": {
        "operation": "insert",
        "table": "draft_responses",
        "columns": "account_id,thread_id,draft_text,explanation,status"
      },
      "notes": "status = pending_approval. Never auto-sent from here \u2014 this row only ever moves forward via the Human Approval Gate."
    },
    {
      "id": "001ee44c-1ba7-4f82-a53f-a5750674eaf4",
      "name": "Human Approval Gate (Wait-for-webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        2000,
        -300
      ],
      "parameters": {
        "path": "support-draft-approval",
        "httpMethod": "POST"
      },
      "notes": "Staff approves or rejects via dashboard action or email reply \u2014 this is the only path that can authorize sending."
    },
    {
      "id": "d10c342a-0489-4286-8ee0-7c4a37e076d3",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2250,
        -300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"decision\"]}}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "APPROVED"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "6c7dd955-243a-49bf-b290-11a94d7cb2d6",
      "name": "Send Reply (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        2500,
        -400
      ],
      "parameters": {
        "operation": "reply",
        "message": "={{$json[\"approved_text\"]}}"
      },
      "notes": "Only fires after explicit staff approval \u2014 never a direct output of the drafting nodes."
    },
    {
      "id": "3b381a86-a3e7-436d-b04b-6ed77ae140ff",
      "name": "Log Rejected Draft (Postgres update)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2500,
        -200
      ],
      "parameters": {
        "operation": "update",
        "table": "draft_responses",
        "updateKey": "id",
        "columns": "status,rejection_reason"
      },
      "notes": "status = rejected. The case stays with the human agent \u2014 no automatic retry or re-send."
    },
    {
      "id": "e096ea65-cd63-4a13-9e3e-c253a7c4202f",
      "name": "Log Email Event (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2750,
        -300
      ],
      "parameters": {
        "operation": "insert",
        "table": "email_audit_log",
        "columns": "sender,intent,action_taken,redaction_flag,timestamp"
      }
    }
  ],
  "connections": {
    "When Called by Router": {
      "main": [
        [
          {
            "node": "Pinecone Retrieval (LangChain)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pinecone Retrieval (LangChain)": {
      "main": [
        [
          {
            "node": "No-Match Fallback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "No-Match Fallback": {
      "main": [
        [
          {
            "node": "Draft Response (Groq, redacted input)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Escalate: No Confident Match (Postgres + Gmail internal)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Draft Response (Groq, redacted input)": {
      "main": [
        [
          {
            "node": "Verify Draft (LangChain, second pass)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Draft (LangChain, second pass)": {
      "main": [
        [
          {
            "node": "Unsupported Claims Found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unsupported Claims Found?": {
      "main": [
        [
          {
            "node": "Flag for Manual Rewrite (Postgres + Gmail internal)",
