            "index": 0
          }
        ],
        [
          {
            "node": "Generate Explanation (LangChain)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Explanation (LangChain)": {
      "main": [
        [
          {
            "node": "Queue for Approval (Postgres insert)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Queue for Approval (Postgres insert)": {
      "main": [
        [
          {
            "node": "Human Approval Gate (Wait-for-webhook)",
