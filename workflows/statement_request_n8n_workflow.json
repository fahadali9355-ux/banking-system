{
  "name": "Statement Request \u2014 Digital Banking Backend (v1.2)",
  "nodes": [
    {
      "id": "49dac485-261c-485d-a9c3-6165e3762b26",
      "name": "When Called by Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "account_holder_id"
            },
            {
              "name": "account_id"
            },
            {
              "name": "thread_id"
            },
            {
              "name": "password"
            },
            {
              "name": "statement_period_start"
            },
            {
              "name": "statement_period_end"
            }
          ]
        }
      },
      "notes": "Receives fields extracted by the Main Email Router for a STATEMENT intent."
    },
    {
      "id": "67b46d62-2014-4c5b-9ecc-540f7e56e645",
      "name": "Execute Workflow: Account Lockout Handler",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        250,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "value": "ACCOUNT_LOCKOUT_HANDLER_WORKFLOW_ID",
          "mode": "id"
        }
      },
      "notes": "Shared sub-workflow (n8n Spec Sec. 3), called with action_type=STATEMENT so password is compared against account_holders.statement_pdf_password_hash, not the transaction password."
    },
    {
      "id": "05770a9c-c72f-4dad-86c3-4ae47f51e371",
      "name": "Lockout Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"match\"]}}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "2d2f4fbd-82f1-42b8-ab79-c9068876f64a",
      "name": "Send Rejection Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "reply",
        "message": "Your request could not be verified. See our previous message for lockout/suspension/attempts-remaining details."
      },
      "notes": "Safety-net stop \u2014 the Lockout Handler itself already sent the specific rejection/suspension/warning email."
    },
    {
      "id": "34182ed6-2287-49c5-8f4e-3443329d06ff",
      "name": "Generate Statement (Python: PDF generation)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        750,
        -150
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/statements/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "period_start",
              "value": "={{$json[\"statement_period_start\"]}}"
            },
            {
              "name": "period_end",
              "value": "={{$json[\"statement_period_end\"]}}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Builds the statement PDF from transaction history for the requested (or default current) period."
    },
    {
      "id": "18d8b76d-b2d7-4de5-a2d1-bd476555dae6",
      "name": "Encrypt PDF (Python service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1000,
        -150
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/statements/encrypt",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "statement_file_id",
              "value": "={{$json[\"statement_file_id\"]}}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Applies a statement_pdf_password_hash-derived password \u2014 distinct from the transaction password. Comparison/derivation happens only in the Python service."
    },
    {
      "id": "429e60a0-4428-4484-b33a-75f7394c282c",
      "name": "Send Statement (Gmail, attachment)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        1250,
        -150
      ],
      "parameters": {
        "operation": "reply",
        "message": "Your requested statement is attached as a password-protected PDF. Use your statement password to open it."
      },
      "notes": "Delivers the encrypted PDF. The email body never contains either the transaction password or the statement password (FR compliance, n8n Spec Sec. 4)."
    },
    {
      "id": "f037f34c-5f08-471e-9101-b8bd4c9a9e01",
      "name": "Log Email Event (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "operation": "insert",
        "table": "email_audit_log",
        "columns": "sender,intent,action_taken,redaction_flag,timestamp"
      },
      "notes": "Every workflow that sends a customer email logs the action to email_audit_log for traceability (Cross-Cutting Notes)."
    }
  ],
  "connections": {
    "When Called by Router": {
      "main": [
        [
          {
            "node": "Execute Workflow: Account Lockout Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Workflow: Account Lockout Handler": {
      "main": [
        [
          {
            "node": "Lockout Passed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lockout Passed?": {
      "main": [
        [
          {
            "node": "Generate Statement (Python: PDF generation)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send Rejection Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Statement (Python: PDF generation)": {
      "main": [
        [
          {
            "node": "Encrypt PDF (Python service)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Encrypt PDF (Python service)": {
      "main": [
        [
          {
            "node": "Send Statement (Gmail, attachment)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Statement (Gmail, attachment)": {
      "main": [
        [
          {
            "node": "Log Email Event (Postgres)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Rejection Email": {
      "main": [
        [
          {
            "node": "Log Email Event (Postgres)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Called from the router for a STATEMENT intent. Runs the shared Account Lockout Handler scoped to the statement password (FR: password check is per-purpose, not account-level), generates the statement PDF, encrypts it with the statement password (kept distinct from the transaction password), and delivers it as an attachment. Every send is logged to email_audit_log."
  },
