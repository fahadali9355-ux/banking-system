{
  "name": "Account Reactivation \u2014 Digital Banking Backend (v1.2) [NEW]",
  "nodes": [
    {
      "id": "4f3b1b4f-d513-4645-971c-55fa7532c2c4",
      "name": "When Called by Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "account_id"
            },
            {
              "name": "account_holder_id"
            },
            {
              "name": "thread_id"
            },
            {
              "name": "email_body"
            }
          ]
        }
      },
      "notes": "Called from the router's Account Status Branch whenever an inbound email arrives from a SUSPENDED account \u2014 including every follow-up reply in the same thread."
    },
    {
      "id": "00aca982-40d1-4f2f-8cd5-adbeb7e8a537",
      "name": "Get Existing Reactivation Request (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        250,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM reactivation_requests WHERE account_id = '{{$json[\"account_id\"]}}' AND status NOT IN ('APPROVED','REJECTED');"
      },
      "notes": "Determines whether this email is opening a new reactivation attempt or continuing one already in progress."
    },
    {
      "id": "f0572801-b847-4361-b69a-d1ace1105126",
      "name": "Request Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.length}}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "5e41dcda-5836-41cc-9c58-f8041106ae10",
      "name": "Create Reactivation Request (Postgres insert)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "insert",
        "table": "reactivation_requests",
        "columns": "account_id,status"
      },
      "notes": "status = PENDING_CHALLENGE. Only created if one is not already open for this account (n8n Spec Sec. 12)."
    },
    {
      "id": "cd79ffc9-f746-4e58-bf0c-e9465ba768b9",
      "name": "Send Identity Challenge (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        1000,
        150
      ],
      "parameters": {
        "operation": "reply",
        "message": "Your account is suspended. To begin reactivation, reply confirming your full name, date of birth, and the amount of your last transaction."
      }
    },
    {
      "id": "fbeaa23f-e15f-4c82-9ad7-a9e8cb977988",
      "name": "Route by Status (Switch)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        750,
        -150
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{$json[\"status\"]}}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "PENDING_CHALLENGE"
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "PENDING_CHALLENGE"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{$json[\"status\"]}}",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "rightValue": "PENDING_STAFF_REVIEW"
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "PENDING_STAFF_REVIEW"
            }
          ]
        }
      },
      "notes": "PENDING_CHALLENGE -> this reply is the identity-answer attempt. PENDING_STAFF_REVIEW / other -> no customer action needed, wait for staff."
    },
    {
      "id": "3e239cc9-9638-4cc8-828c-b5ce2a8d978f",
      "name": "Verify Identity Answers (Python service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1000,
        -250
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/auth/verify-identity",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "email_body",
              "value": "={{$json[\"email_body\"]}}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Checks the reply against users/account data (full name, DOB, last transaction amount)."
    },
    {
      "id": "58e15817-2b80-4b5b-adce-399e01594529",
      "name": "Identity Correct?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1250,
        -250
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"identity_challenge_passed\"]}}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "345b434f-9b75-4e4b-8161-dbbf0e49ecab",
      "name": "Update Request: Identity Passed (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1500,
        -400
      ],
      "parameters": {
        "operation": "update",
        "table": "reactivation_requests",
        "updateKey": "id",
        "columns": "identity_challenge_passed,status"
      },
      "notes": "status -> PENDING_OTP."
    },
    {
      "id": "7e7c57af-987f-4af5-971d-935d5ecaf7f2",
      "name": "Send Phone OTP (SMS service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1750,
        -400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/auth/issue-challenge-code",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "context",
              "value": "REACTIVATION"
            },
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            }
          ]
        },
        "options": {}
      },
      "notes": "Sent only after the identity challenge passes (n8n Spec Sec. 12)."
    },
    {
      "id": "c7d7661a-78b6-4aea-8873-74816551d8fb",
      "name": "Increment Identity Attempts (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1500,
        -100
      ],
      "parameters": {
        "operation": "update",
        "table": "reactivation_requests",
        "updateKey": "id",
        "columns": "identity_attempts"
      }
    },
    {
      "id": "a3b57cb9-60f3-409b-a251-d2508b8c499f",
      "name": "Identity Attempts >= 3?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1750,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"identity_attempts\"]}}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 3
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "ea384988-b66a-4476-8969-d066077b099b",
      "name": "Re-prompt Identity Challenge (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        2000,
        -50
      ],
      "parameters": {
        "operation": "reply",
        "message": "That doesn't match our records. Please reply again with your full legal name, date of birth, and last transaction amount."
      }
    },
    {
      "id": "8821d0bf-12ed-4455-8688-ad4edf20d6c9",
      "name": "Escalate: Possible Fraud Signal (Postgres + Gmail internal)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        2000,
        -200
      ],
      "parameters": {
        "operation": "send",
        "message": "Reactivation identity challenge failed 3 times for a SUSPENDED account \u2014 possible fraud signal. Manual review requested before any further contact."
      },
      "notes": "Bounded retry exhausted; escalated as a possible fraud signal rather than silently re-prompted forever (n8n Spec Sec. 12)."
    },
    {
      "id": "99cd63dc-0920-49db-80ac-ea6d4c83c67a",
      "name": "Wait for Phone OTP (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        2000,
        -400
      ],
      "parameters": {
        "path": "reactivation-otp-confirm",
        "httpMethod": "POST"
      }
    },
    {
      "id": "bded134a-1426-47ed-a16a-fe725286b609",
      "name": "Verify Phone OTP (Python: /auth/verify-otp)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        2250,
        -400
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/auth/verify-otp",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "context",
              "value": "REACTIVATION"
            },
            {
              "name": "reference_id",
              "value": "={{$json[\"reactivation_request_id\"]}}"
            },
            {
              "name": "otp",
              "value": "={{$json[\"otp\"]}}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "8185935e-e60b-43a0-9f0c-5770306f8189",
      "name": "OTP Verified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2500,
        -400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"verified\"]}}",
              "operator": {
                "type": "boolean",
                "operation": "true"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "54764b59-f446-418a-a392-8eed7a60502f",
      "name": "Update Request: PENDING_STAFF_REVIEW (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2750,
        -500
      ],
      "parameters": {
        "operation": "update",
        "table": "reactivation_requests",
        "updateKey": "id",
        "columns": "phone_otp_verified_at,status"
      },
      "notes": "phone_otp_verified_at = now(); status -> PENDING_STAFF_REVIEW."
    },
    {
      "id": "c363a714-98bf-4212-8cf8-cb600c5f52bb",
      "name": "Notify Staff Review Queue (Gmail internal)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        3000,
        -500
      ],
      "parameters": {
        "operation": "send",
        "message": "A suspended account has passed identity + phone OTP re-verification and is ready for staff review to lift the suspension."
      }
    },
    {
      "id": "fe033323-134f-4bd1-b232-d9d2921ae2e5",
      "name": "Re-issue Phone OTP / Escalate (IF: attempts >= 3)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        2750,
        -300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"otp_attempts\"]}}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 3
            }
          ],
          "combinator": "and"
        }
      },
      "notes": "Incorrect/expired OTP re-prompts within a bounded window; exhausting it escalates the same as a failed identity challenge."
    },
    {
      "id": "931941bd-18f7-4735-9d13-468a71e714f3",
      "name": "Staff Review Gate (Webhook / staff dashboard)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        3250,
        -500
      ],
      "parameters": {
        "path": "reactivation-staff-decision",
        "httpMethod": "POST"
      },
      "notes": "Only a staff member can resolve this. Never automated, regardless of how the identity and OTP gates resolved (n8n Spec Sec. 12 / Sec. 13)."
    },
    {
      "id": "7e25ce5a-cf8e-4954-86c4-645a55488d7f",
      "name": "Staff Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        3500,
        -500
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"decision\"]}}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "APPROVED"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "b330a4d9-b716-442d-8432-7300edff972f",
      "name": "Lift Suspension (Postgres update)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        3750,
        -600
      ],
      "parameters": {
        "operation": "update",
        "table": "accounts",
        "updateKey": "id",
        "columns": "status"
      },
      "notes": "accounts.status = ACTIVE; reactivation_requests.status = APPROVED."
    },
    {
      "id": "953ac07a-d858-4c7d-935d-a5e5f475a6c8",
      "name": "Record Rejection (Postgres update)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        3750,
        -400
      ],
      "parameters": {
        "operation": "update",
        "table": "reactivation_requests",
        "updateKey": "id",
        "columns": "status"
      },
      "notes": "reactivation_requests.status = REJECTED."
    },
    {
      "id": "4f56b811-1ea3-4387-b4e0-8f90b49d0b20",
      "name": "Notify Outcome: Reactivated (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        4000,
        -600
      ],
      "parameters": {
        "operation": "send",
        "message": "Your account has been reactivated. You can resume normal use immediately."
      }
    },
    {
      "id": "6600e070-ad55-4534-b452-07eb67296513",
      "name": "Notify Outcome: Rejected (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        4000,
        -400
      ],
      "parameters": {
        "operation": "send",
        "message": "Your reactivation request was not approved after staff review. Please contact support for next steps."
      }
    }
  ],
