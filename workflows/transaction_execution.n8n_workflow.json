{
  "name": "Transaction Execution — Digital Banking Backend (v1.2)",
  "nodes": [
    {
      "id": "0827d80d-b660-4c8e-ae67-a463381329e5",
      "name": "When Called by Router",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "account_holder_id"
            },
            {
              "name": "account_id"
            },
            {
              "name": "thread_id"
            },
            {
              "name": "password"
            },
            {
              "name": "challenge_code"
            },
            {
              "name": "amount"
            },
            {
              "name": "recipient_account_token"
            },
            {
              "name": "idempotency_key"
            }
          ]
        }
      },
      "notes": "Receives the fields extracted/classified by the Main Email Router (FR-6.9: account_holder_id identifies the sending holder specifically)."
    },
    {
      "id": "36c5c922-1e6c-49b3-b849-a1b7bd646d4f",
      "name": "Execute Workflow: Account Lockout Handler",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        250,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "value": "ACCOUNT_LOCKOUT_HANDLER_WORKFLOW_ID",
          "mode": "id"
        }
      },
      "notes": "Shared sub-workflow (n8n Spec Sec. 3). Must pass before continuing — checks SUSPENDED status first, then verifies account_holders.transaction_password_hash, manages failed_password_attempts counter and 3-strike suspension."
    },
    {
      "id": "22f43222-affc-4e49-9abe-eea490f0060e",
      "name": "Lockout Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"match\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "6a39590a-02fe-4a3a-894c-f726d26798bb",
      "name": "Send Rejection Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        750,
        150
      ],
      "parameters": {
        "operation": "reply",
        "message": "Your request could not be verified. See our previous message for lockout/suspension/attempts-remaining details."
      },
      "notes": "Covers wrong password, attempts-remaining warning, and SUSPENDED fixed-rejection — the Lockout Handler itself already sent the specific email; this is a safety-net stop."
    },
    {
      "id": "6f115ee4-285b-46f9-b1da-6a1b82845f17",
      "name": "Verify Challenge Code (Python: /auth/verify-password)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/auth/verify-password",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_holder_id",
              "value": "={{$json[\"account_holder_id\"]}}"
            },
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "action_type",
              "value": "TRANSACTION"
            },
            {
              "name": "password",
              "value": "={{$json[\"password\"]}}"
            },
            {
              "name": "challenge_code",
              "value": "={{$json[\"challenge_code\"]}}"
            }
          ]
        },
        "options": {}
      },
      "notes": "FR-6.10/NFR-9: validates the 5-minute single-use code from transaction_challenge_codes. 410 = expired/used -> distinct error path, does NOT touch failed_password_attempts."
    },
    {
      "id": "b27abdcc-e931-4e35-b6ab-8334c705f3d0",
      "name": "Challenge Code Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1250,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"challenge_code_valid\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "12d0068c-295c-4b56-91fc-50adb561b802",
      "name": "Issue New Challenge Code + Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1500,
        150
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/auth/issue-challenge-code",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "thread_id",
              "value": "={{$json[\"thread_id\"]}}"
            }
          ]
        }
      },
      "notes": "Missing/expired/used code: issue a fresh one into this thread and ask the customer to reply with password + new code (does not increment the password failure counter)."
    },
    {
      "id": "027bbe62-7b48-49a6-9456-97f531320247",
      "name": "Idempotency Check (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT response_payload FROM idempotency_keys WHERE key = '{{$json[\"idempotency_key\"]}}';"
      },
      "notes": "FR-2.1: duplicate idempotency_key returns the ORIGINAL stored response, not a fresh error."
    },
    {
      "id": "3b14c873-d12f-45ca-8310-ac124f4a4fb7",
      "name": "Already Processed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1750,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.length}}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "396b92d5-477f-4e92-b19f-192a64cdecb3",
      "name": "Reply With Original Result",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        2000,
        150
      ],
      "parameters": {
        "operation": "reply",
        "message": "={{$json[\"response_payload\"]}}"
      },
      "notes": "Duplicate submission — replay the stored result, never re-execute."
    },
    {
      "id": "417cbbda-3ef0-4533-9b66-7729e5460f04",
      "name": "Authority Check (Postgres + Function)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT authority_type FROM accounts WHERE id = '{{$json[\"account_id\"]}}';"
      },
      "notes": "Applies EITHER_OR / JOINT_SIGNATURE / MAJORITY_VOTE rules from account configuration."
    },
    {
      "id": "76341584-3012-469d-852d-408990223676",
      "name": "Authority Type Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        2250,
        0
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json[\"authority_type\"]}}",
                    "rightValue": "JOINT_SIGNATURE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "JointSignature"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json[\"authority_type\"]}}",
                    "rightValue": "EITHER_OR",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "EitherOr"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json[\"authority_type\"]}}",
                    "rightValue": "MAJORITY_VOTE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "MajorityVote"
            }
          ]
        }
      }
    },
    {
      "id": "631b6b2d-059e-4c41-83fd-5b08c979d0c4",
      "name": "Create Approval Request (Python: /transactions/approval-requests)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        2500,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/transactions/approval-requests",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "idempotency_key",
              "value": "={{$json[\"idempotency_key\"]}}"
            },
            {
              "name": "initiated_by",
              "value": "={{$json[\"account_holder_id\"]}}"
            }
          ]
        }
      },
      "notes": "FR-1.11: opens transaction_approval_requests row, linked to this idempotency_key; expires_at = fixed decision window."
    },
    {
      "id": "10545106-3e35-4175-8c21-25f54593baba",
      "name": "Notify Other Holder (Gmail)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        2750,
        -200
      ],
      "parameters": {
        "operation": "send",
        "message": "A transaction on your joint account requires your approval. Reply/click to approve or reject; you will receive a phone OTP to confirm."
      }
    },
    {
      "id": "13274200-6b61-4bb4-8c2a-d30ba301d17a",
      "name": "Collect Approval (Webhook + Phone OTP + Postgres)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        3000,
        -200
      ],
      "parameters": {
        "path": "joint-signature-approval",
        "httpMethod": "POST"
      },
      "notes": "Second holder's approval requires phone-OTP confirmation (context=TRANSACTION_APPROVAL via /auth/verify-otp), not the email link alone."
    },
    {
      "id": "861c1bd5-c97b-451e-a100-694f1e4376d8",
      "name": "Resolve Transaction Approval (Python: /transactions/approval-requests/resolve)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        3250,
        -200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/transactions/approval-requests/resolve",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "approval_request_id",
              "value": "={{$json[\"approval_request_id\"]}}"
            },
            {
              "name": "holder_id",
              "value": "={{$json[\"holder_id\"]}}"
            },
            {
              "name": "decision",
              "value": "={{$json[\"decision\"]}}"
            }
          ]
        }
      },
      "notes": "Service re-validates unanimity itself; 410 = window expired -> ESCALATED."
    },
    {
      "id": "e078c3cc-c06c-479c-9a65-07a6c3ef0a2a",
      "name": "Approval Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        3500,
        -200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"ready_to_execute\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "notes": "Approved -> proceed to Execute Transfer. Rejected or window expired -> escalate to manual review, do not execute (always human sign-off per SRS 3.8)."
    },
    {
      "id": "83ddfced-c0c3-4f7b-a0dc-6ecaa0397f42",
      "name": "Escalate to Manual Review (Postgres + Gmail internal)",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        3750,
        -350
      ],
      "parameters": {
        "operation": "send",
        "message": "JOINT_SIGNATURE transaction escalated: second holder rejected or window expired. Manual staff review required."
      },
      "notes": "Human sign-off action — never auto-executed and never silently dropped."
    },
    {
      "id": "517adb96-68e3-43ec-b814-c6e696d8d191",
      "name": "Execute Transfer (Python: /transactions/execute)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        4000,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/transactions/execute",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "idempotency_key",
              "value": "={{$json[\"idempotency_key\"]}}"
            },
            {
              "name": "from_account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "to_account_id",
              "value": "={{$json[\"recipient_account_token\"]}}"
            },
            {
              "name": "amount",
              "value": "={{$json[\"amount\"]}}"
            },
            {
              "name": "type",
              "value": "TRANSFER_OUT"
            },
            {
              "name": "initiated_by_holder_id",
              "value": "={{$json[\"account_holder_id\"]}}"
            },
            {
              "name": "description",
              "value": "={{$json[\"description\"]}}"
            }
          ]
        }
      },
      "notes": "FR-2.2/FR-2.3: atomic debit+credit under row-level locking. The ONLY path that changes accounts.balance for a transfer."
    },
    {
      "id": "a7ce54d7-743a-49a3-accd-c0bda572247c",
      "name": "Fraud Score (Python: /fraud/score)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        4250,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"PYTHON_SERVICES_BASE_URL\"]}}/fraud/score",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "transaction_id",
              "value": "={{$json[\"transaction_id\"]}}"
            },
            {
              "name": "account_id",
              "value": "={{$json[\"account_id\"]}}"
            },
            {
              "name": "amount",
              "value": "={{$json[\"amount\"]}}"
            }
          ]
        }
      },
      "notes": "FR-5.7: combines rule-based/anomaly score with Pinecone fraud-pattern match. On breach, calls Fraud Monitoring workflow instead of confirming."
    },
    {
      "id": "24ed2096-9fa0-4f5e-90e0-036f8bb1a431",
      "name": "Fraud Breach?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        4500,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json[\"flag\"]}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "5457a6cd-502d-4c28-b93a-04c93aaed66d",
      "name": "Execute Workflow: Fraud Monitoring",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        4750,
        -150
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "value": "FRAUD_MONITORING_WORKFLOW_ID",
          "mode": "id"
        }
      },
      "notes": "Places hold (fraud_flags, status=HELD), sends OTP-secured confirm-it-was-me link + phone OTP."
    },
    {
      "id": "fffa712a-9072-438c-b02b-e554a5312347",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [
        4750,
        150
      ],
      "parameters": {
        "operation": "reply",
        "message": "Your transfer of {{$json[\"amount\"]}} has been completed. New balance: {{$json[\"new_balance\"]}}."
      },
      "notes": "FR-2.4: confirms success, or explains rollback/escalation reason on failure (status=ROLLED_BACK with reason)."
    },
    {
      "id": "130f4b8d-8937-4ad2-8739-26067c7eec7e",
      "name": "Log Email Event (Postgres)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [
        5000,
        0
      ],
      "parameters": {
        "operation": "insert",
        "table": "email_audit_log",
        "columns": "thread_id,sender_email,account_id,intent,action_taken,redaction_applied"
      },
      "notes": "Every workflow that sends a customer email logs to email_audit_log."
    }
  ],
